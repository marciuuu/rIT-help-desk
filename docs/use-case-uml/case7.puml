@startuml
' Configurações visuais
skinparam maxMessageSize 150
skinparam handwritten false
skinparam responseMessageBelowArrow true
autonumber

actor "Técnico / Admin" as user
participant "Interface (PWA)" as pwa

box "Qualquer Módulo (ex: Tickets / Auth)" #F0F8FF
    participant "Service (Negócio)" as service
end box

box "Event Bus Interno" #FFFFE0
    participant "Spring Event\nPublisher" as eventBus
end box

box "Módulo: Governance" #F5F5F5
    participant "AuditController\n(API)" as apiGov
    participant "AuditLogService\n(Governança)" as gov
    database "Banco de Dados" as db
end box

== Parte A: Interceptação Automática (Event-Driven) ==
note over service, eventBus : Qualquer alteração de estado no sistema\ngera um evento de domínio, desacoplando o log da ação principal.

[-> service : Executa transação principal\n(ex: alterar status do ticket)
activate service
service -> eventBus : publishEvent(EntidadeAlteradaEvent)
service -->[ : Retorna sucesso IMEDIATO ao usuário (HTTP 20X)
deactivate service

== Processamento em Segundo Plano (@Async) ==

eventBus ->> gov : Recebe EntidadeAlteradaEvent
activate gov
gov -> gov : Captura timestamp exato\ne estrutura objeto imutável
gov -> db : INSERT INTO log_auditoria (tabela append-only)
activate db
db --> gov : Confirma gravação
deactivate db
deactivate gov

== Parte B: Consulta da Linha do Tempo (Lifecycle) ==

user -> pwa : Acessa detalhes do chamado\ne clica em "Histórico"
pwa -> apiGov : GET /chamados/{id}/auditoria
activate apiGov

apiGov -> gov : buscarHistoricoPorChamado(id)
activate gov
gov -> gov : Valida permissões de leitura do JWT

gov -> db : SELECT * FROM log_auditoria\nWHERE chamado_id = {id} ORDER BY data_hora DESC
activate db
db --> gov : Retorna eventos cronológicos
deactivate db

gov --> apiGov : Retorna DTOs
deactivate gov

apiGov --> pwa : Retorna array JSON
deactivate apiGov

pwa --> user : Renderiza linha do tempo visual\n(ex: "João alterou de Aberto para Em Andamento às 14:30")

@enduml