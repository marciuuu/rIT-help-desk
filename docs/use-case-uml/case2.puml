@startuml
' Configurações visuais
skinparam maxMessageSize 150
skinparam handwritten false
skinparam responseMessageBelowArrow true
autonumber

' Atores e Interface
actor "Técnico / Admin" as tecnico
participant "Interface (PWA)" as pwa

' Representação do Monólito Modular
box "Módulo: Tickets (Core)" #F0F8FF
    participant "TicketController\n(API)" as api
    participant "TicketService\n(Negócio)" as service
    database "Banco de Dados" as db
end box

box "Event Bus Interno" #FFFFE0
    participant "Spring Event\nPublisher" as eventBus
end box

box "Módulo: Governance" #F5F5F5
    participant "AuditLogService\n(Governança)" as gov
end box

' 1. Consulta da Fila (Backlog)
tecnico -> pwa : Acessa a Fila de Entrada (Backlog)
pwa -> api : GET /chamados?status=ABERTO

activate api
api -> service : buscarChamadosPorStatus("ABERTO")
activate service
service -> db : SELECT * FROM chamados WHERE status = 'ABERTO'
activate db
db --> service : Retorna lista de chamados
deactivate db
service --> api : Retorna DTOs dos chamados
deactivate service
api --> pwa : Retorna array JSON
deactivate api

pwa --> tecnico : Exibe quadro Kanban / Lista de Backlog

' 2. Interação e Atribuição
tecnico -> pwa : Abre chamado, define Prioridade\ne clica em "Assumir Chamado"
pwa -> api : PUT /chamados/{id}/atribuicao\n(Payload: Prioridade, ID Técnico)

activate api
api -> service : atribuirChamado(id, payload)
activate service

' Validação de Segurança e de Negócio
service -> service : Valida permissões (RBAC)
service -> service : Verifica se o chamado já foi assumido (Concorrência)

alt Validação Falha (Chamado já atribuído)
    service --> api : Lança Exceção (Conflito)
    api --> pwa : Retorna Erro (HTTP 409 Conflict)
    pwa --> tecnico : Exibe aviso: "Este chamado já foi assumido"
else Validação Bem-sucedida
    ' Atualização do Banco de Dados (Transação Principal)
    service -> db : UPDATE chamados SET status = 'EM_ANDAMENTO',\nprioridade = {nova}, tecnico_id = {id}
    activate db
    db --> service : Confirma alteração
    deactivate db
    
    ' Disparo do Evento de Domínio (Desacoplamento)
    service -> eventBus : publishEvent(TicketAtribuidoEvent)
    
    ' Retorno IMEDIATO para o usuário
    service --> api : Retorna dados atualizados do ticket
    deactivate service
    
    api --> pwa : Retorna Sucesso (HTTP 200 OK)
    pwa --> tecnico : Move o card para a coluna "Em Andamento"\ne exibe notificação
end
deactivate api

' ==========================================
' PROCESSAMENTO ASSÍNCRONO (EM SEGUNDO PLANO)
' ==========================================
== Processamento em Segundo Plano (@Async) ==

eventBus ->> gov : Recebe TicketAtribuidoEvent
activate gov
gov -> db : INSERT INTO log_auditoria\n(Ação: Triagem, Valores Antigos/Novos)
activate db
db --> gov : Confirma gravação imutável
deactivate db
deactivate gov

@enduml