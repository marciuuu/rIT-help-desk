@startuml
' Configurações visuais
skinparam maxMessageSize 150
skinparam handwritten false
skinparam responseMessageBelowArrow true
autonumber

' Atores e Interface
actor "Administrador" as admin
participant "Interface (PWA)" as pwa

' Representação do Monólito Modular (Separado por Domínio)
box "Módulo: Auth (Identidade)" #E8F8F5
    participant "UsuarioController\n(API)" as apiAuth
    participant "UsuarioService\n(Negócio)" as serviceAuth
    database "Banco de Dados" as dbAuth
end box

box "Módulo: Tickets (Core)" #F0F8FF
    participant "CategoriaController\n(API)" as apiCat
    participant "CategoriaService\n(Negócio)" as serviceCat
    database "Banco de Dados" as dbCat
end box

box "Event Bus Interno" #FFFFE0
    participant "Spring Event\nPublisher" as eventBus
end box

box "Módulo: Governance" #F5F5F5
    participant "AuditLogService\n(Governança)" as gov
end box

== Gestão de Usuários e Perfis ==

admin -> pwa : Acessa painel de "Gestão de Usuários"
pwa -> apiAuth : GET /usuarios

activate apiAuth
apiAuth -> serviceAuth : buscarUsuarios()
activate serviceAuth
serviceAuth -> serviceAuth : Valida permissões (Role = 'ADMIN')
serviceAuth -> dbAuth : SELECT * FROM usuarios
dbAuth --> serviceAuth : Retorna usuários
serviceAuth --> apiAuth : Retorna DTOs
deactivate serviceAuth
apiAuth --> pwa : Retorna array JSON
deactivate apiAuth

pwa --> admin : Exibe listagem na interface

admin -> pwa : Preenche dados e define Perfil (Tabela Única)\ne clica em "Salvar"
pwa -> apiAuth : POST /usuarios\n(Payload: dados, perfil)

activate apiAuth
apiAuth -> serviceAuth : criarUsuario(payload)
activate serviceAuth
serviceAuth -> serviceAuth : Valida token JWT (Role = 'ADMIN')
serviceAuth -> serviceAuth : Valida regras de negócio (ex: e-mail duplicado)

alt Validação Falha (E-mail Duplicado)
    serviceAuth --> apiAuth : Lança Exceção (Conflict)
    apiAuth --> pwa : Retorna Erro (HTTP 409 Conflict)
    pwa --> admin : Exibe alerta "Este e-mail já existe"
else Validação Bem-sucedida
    serviceAuth -> serviceAuth : Criptografa senha (Hash BCrypt)
    
    ' Aplicação da Tabela Única - Inserção sem Foreign Key de Perfil
    serviceAuth -> dbAuth : INSERT INTO usuarios\n(dados, perfil, hash_senha)
    activate dbAuth
    dbAuth --> serviceAuth : Confirmação
    deactivate dbAuth
    
    ' Disparo de Evento
    serviceAuth -> eventBus : publishEvent(UsuarioCriadoEvent)
    
    serviceAuth --> apiAuth : Retorna DTO gerado
    deactivate serviceAuth
    
    apiAuth --> pwa : Retorna Sucesso (HTTP 201 Created)
    pwa --> admin : Exibe alerta "Usuário cadastrado com sucesso"
end
deactivate apiAuth

== Gestão de Árvore de Categorias ==

admin -> pwa : Acessa painel de "Categorias de Serviço"
pwa -> apiCat : GET /categorias

activate apiCat
apiCat -> serviceCat : listarCategoriasHierarquia()
activate serviceCat
serviceCat -> dbCat : SELECT * FROM categorias ORDER BY hierarquia
dbCat --> serviceCat : Retorna categorias
serviceCat --> apiCat : Retorna DTOs hierárquicos
deactivate serviceCat
apiCat --> pwa : Retorna array JSON
deactivate apiCat

pwa --> admin : Exibe árvore de categorias (ex: Hardware > Memória)

admin -> pwa : Adiciona nova subcategoria\ne clica em "Salvar"
pwa -> apiCat : POST /categorias\n(Payload: nome, categoria_pai_id)

activate apiCat
apiCat -> serviceCat : criarCategoria(payload)
activate serviceCat
serviceCat -> serviceCat : Valida token JWT (Role = 'ADMIN')
serviceCat -> dbCat : INSERT INTO categorias (nome, categoria_pai_id)
activate dbCat
dbCat --> serviceCat : Confirmação
deactivate dbCat

serviceCat -> eventBus : publishEvent(CategoriaCriadaEvent)

serviceCat --> apiCat : Retorna DTO
deactivate serviceCat

apiCat --> pwa : Retorna Sucesso (HTTP 201 Created)
pwa --> admin : Atualiza a árvore visual na tela
deactivate apiCat

== Processamento em Segundo Plano (@Async) ==

eventBus ->> gov : Recebe UsuarioCriadoEvent / CategoriaCriadaEvent
activate gov
gov -> dbAuth : INSERT INTO log_auditoria\n(Ação administrativa no sistema)
deactivate gov

@enduml