@startuml
' Configurações visuais para um aspecto profissional e moderno
skinparam packageStyle rectangle
skinparam actorStyle hollow
skinparam handwritten false
skinparam shadowtl false

' Orientação do diagrama da esquerda para a direita
left to right direction

' Definição dos Atores (Humanos à esquerda, Automático à direita)
actor "Solicitante\n(Usuário Comum)" as solicitante
actor "Técnico\n(Suporte)" as tecnico
actor "Administrador\n(Gestor de TI)" as admin

actor "Sistema\n(Automático / Background)" as sistema

package "rIT Help Desk — Monólito Modular" {
  
  ' Cenário 0
  usecase "Cenário 0: Autenticação\n(JWT e Tabela Única)" as UC0
  
  ' Cenário 1
  usecase "Cenário 1: Abertura de Chamado" as UC1
  
  ' Cenário 2
  usecase "Cenário 2: Triagem e Atribuição" as UC2
  
  ' Cenário 3
  usecase "Cenário 3: Atendimento e Comunicação" as UC3
  
  ' Cenário 4
  usecase "Cenário 4: Resolução e Fechamento\n(Homologação/Reabertura)" as UC4
  
  ' Cenário 5
  usecase "Cenário 5: Gestão de Usuários\ne Categorias (RBAC)" as UC5
  
  ' Cenário 6
  usecase "Cenário 6: Acompanhamento Visual\n(Quadro Kanban)" as UC6
  
  ' Cenário 7
  usecase "Cenário 7: Rastreabilidade\n(Auditoria Event-Driven)" as UC7
  
  ' Cenário 8
  usecase "Cenário 8: Monitoramento SLA\ne Notificações" as UC8
  
  ' Cenário 9
  usecase "Cenário 9: Extração de Métricas\ne Dashboards" as UC9
}

' --- VÍNCULOS DOS ATORES HUMANOS ---
solicitante --> UC0
solicitante --> UC1
solicitante --> UC3
solicitante --> UC4

tecnico --> UC0
tecnico --> UC2
tecnico --> UC3
tecnico --> UC4
tecnico --> UC6
tecnico --> UC7

admin --> UC0
admin --> UC2
admin --> UC5
admin --> UC6
admin --> UC7
admin --> UC9

' --- VÍNCULOS DO SISTEMA AUTOMÁTICO (ASSÍNCRONO E EVENTOS) ---
UC0 --> sistema : Validação JWT
UC1 --> sistema : Evento: Ticket Criado (Notificar)
UC3 --> sistema : Evento: Interação (Alertar)
UC4 --> sistema : Evento: Resolução (Congelar SLA)
UC6 --> sistema : Evento: Transição (Auditar Kanban)

' Inversão de direção para tarefas iniciadas ativamente pelo sistema
sistema --> UC7 : Gravação Imutável em Segundo Plano
sistema --> UC8 : Varredura Contínua (Cron Job)
UC9 --> sistema : Agregação de Dados no Banco

@enduml