@startuml
' Configurações visuais para um aspecto profissional e moderno
skinparam packageStyle rectangle
skinparam actorStyle hollow
skinparam handwritten false
skinparam shadowtl false

' Orientação do diagrama da esquerda para a direita
left to right direction

' Definição dos Atores (Humanos à esquerda, Automático à direita)
actor "Solicitante\n(Usuário Comum)" as solicitante
actor "Técnico\n(Suporte)" as tecnico
actor "Administrador\n(Gestor de TI)" as admin

actor "Sistema\n(Automático)" as sistema

package "rIT Help Desk — Escopo do Sistema" {
  
  ' Cenário 0
  usecase "Cenário 0: Autenticação e Autorização\n(Login com JWT / RBAC)" as UC0
  
  ' Cenário 1
  usecase "Cenário 1: Abertura de Chamado\n(Criação de Ticket)" as UC1
  
  ' Cenário 2
  usecase "Cenário 2: Triagem e Atribuição\n(Gestão de Fila / Backlog)" as UC2
  
  ' Cenário 3
  usecase "Cenário 3: Atendimento e Comunicação\n(Interações e Notas Internas)" as UC3
  
  ' Cenário 4
  usecase "Cenário 4: Resolução e Fechamento\n(Homologação ou Reabertura)" as UC4
  
  ' Cenário 5
  usecase "Cenário 5: Gestão de Usuários\ne Categorias" as UC5
  
  ' Cenário 6
  usecase "Cenário 6: Acompanhamento Visual\n(Quadro Kanban)" as UC6
  
  ' Cenário 7
  usecase "Cenário 7: Rastreabilidade\n(Trilha de Auditoria Imutável)" as UC7
  
  ' Cenário 8
  usecase "Cenário 8: Monitoramento de SLA\ne Notificações" as UC8
  
  ' Cenário 9
  usecase "Cenário 9: Extração de Métricas\ne Relatórios Gerenciais" as UC9
}

' --- VÍNCULOS DO SOLICITANTE ---
solicitante --> UC0
solicitante --> UC1
solicitante --> UC3
solicitante --> UC4

' --- VÍNCULOS DO TÉCNICO ---
tecnico --> UC0
tecnico --> UC2
tecnico --> UC3
tecnico --> UC4
tecnico --> UC6
tecnico --> UC7

' --- VÍNCULOS DO ADMINISTRADOR ---
admin --> UC0
admin --> UC2
admin --> UC5
admin --> UC6
admin --> UC7
admin --> UC9

' --- VÍNCULOS DO SISTEMA AUTOMÁTICO ---
UC0 --> sistema : Geração de Token
UC1 --> sistema : Disparo de Alertas
UC3 --> sistema : Registro de Histórico
UC4 --> sistema : Cômputo de SLA
UC6 --> sistema : Intercepção de Status
UC7 --> sistema : Gravação de Log
UC8 --> sistema : Cálculo de Tempo
UC9 --> sistema : Compilação de Dados

@enduml