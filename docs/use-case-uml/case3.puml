@startuml
' Configurações visuais
skinparam maxMessageSize 150
skinparam handwritten false
skinparam responseMessageBelowArrow true
autonumber

' Atores e Interface
actor "Técnico" as tecnico
actor "Solicitante" as solicitante
participant "Interface (PWA)" as pwa

' Representação do Monólito Modular
box "Módulo: Tickets (Core)" #F0F8FF
    participant "TicketController\n(API)" as api
    participant "TicketService\n(Negócio)" as service
    database "Banco de Dados" as db
end box

box "Event Bus Interno" #FFFFE0
    participant "Spring Event\nPublisher" as eventBus
end box

box "Módulos Secundários" #F5F5F5
    participant "Módulo\nGovernance" as gov
    participant "Módulo\nNotifications" as notif
end box

== Parte A: Interação Iniciada pelo Técnico ==

tecnico -> pwa : Digita a mensagem no painel do chamado

alt Fluxo Principal: Comentário Público (Solicitação de Dados)
    pwa -> api : POST /chamados/{id}/interacoes\n(Payload: texto, visibilidade='PUBLICO')
    activate api
    api -> service : adicionarInteracao(id, payload)
    activate service
    
    service -> service : Valida token JWT e perfil Técnico
    
    ' Persistência e alteração de estado (Transação Principal)
    service -> db : INSERT INTO interacoes (chamado_id, texto, is_interna=false)
    service -> db : UPDATE chamados SET status = 'AGUARDANDO_USUARIO'
    
    ' Disparo de Evento de Domínio
    service -> eventBus : publishEvent(TicketStatusAlteradoEvent)
    
    ' Retorno imediato
    service --> api : Retorna DTO da interação
    deactivate service
    api --> pwa : Retorna Sucesso (HTTP 201 Created)
    pwa --> tecnico : Atualiza a timeline e move status
    deactivate api

    ' Processamento Assíncrono (Comentário Público)
    note over eventBus, notif : Processamento em Segundo Plano (@Async)
    
    eventBus ->> gov : Recebe TicketStatusAlteradoEvent
    activate gov
    gov -> db : INSERT INTO log_auditoria\n(Ação: Mudança Status, Antigo: Em Andamento, Novo: Aguardando)
    deactivate gov
    
    eventBus ->> notif : Recebe TicketStatusAlteradoEvent
    activate notif
    notif ->> solicitante : Notifica Solicitante assincronamente (E-mail / PWA)
    deactivate notif

else Fluxo Alternativo: Nota Interna (Oculta para o Solicitante)
    pwa -> api : POST /chamados/{id}/interacoes\n(Payload: texto, visibilidade='INTERNO')
    activate api
    api -> service : adicionarInteracao(id, payload)
    activate service
    
    service -> service : Valida permissão interna de TI
    
    service -> db : INSERT INTO interacoes (chamado_id, texto, is_interna=true)
    service -> eventBus : publishEvent(NotaInternaCriadaEvent)
    
    service --> api : Retorna DTO da interação
    deactivate service
    api --> pwa : Retorna Sucesso (HTTP 201 Created)
    pwa --> tecnico : Exibe a nota com marcador "Privado (Apenas TI)"
    deactivate api

    ' Processamento Assíncrono (Nota Interna)
    note over eventBus, gov : Processamento em Segundo Plano (@Async)
    eventBus ->> gov : Recebe NotaInternaCriadaEvent
    activate gov
    gov -> db : INSERT INTO log_auditoria\n(Ação: Registro de Nota Interna)
    deactivate gov
    ' Nenhuma notificação é enviada para o solicitante
end

== Parte B: Resposta do Solicitante ==

solicitante -> pwa : Abre a notificação, digita a resposta e clica em "Enviar"
pwa -> api : POST /chamados/{id}/interacoes\n(Payload: texto, visibilidade='PUBLICO')

activate api
api -> service : adicionarInteracao(id, payload)
activate service
service -> service : Valida token JWT do Solicitante

' Persistência e retorno ao fluxo técnico
service -> db : INSERT INTO interacoes (chamado_id, texto, is_interna=false)
service -> db : UPDATE chamados SET status = 'EM_ANDAMENTO'

service -> eventBus : publishEvent(TicketStatusAlteradoEvent)

service --> api : Retorna DTO da interação
deactivate service
api --> pwa : Retorna Sucesso (HTTP 201 Created)
pwa --> solicitante : Adiciona a resposta na timeline
deactivate api

' Processamento Assíncrono (Resposta do Solicitante)
note over eventBus, notif : Processamento em Segundo Plano (@Async)

eventBus ->> gov : Recebe TicketStatusAlteradoEvent
activate gov
gov -> db : INSERT INTO log_auditoria\n(Ação: Mudança Status, Antigo: Aguardando, Novo: Em Andamento)
deactivate gov

eventBus ->> notif : Recebe TicketStatusAlteradoEvent
activate notif
notif ->> tecnico : Notifica Técnico Atribuído assincronamente (E-mail / PWA)
deactivate notif

@enduml