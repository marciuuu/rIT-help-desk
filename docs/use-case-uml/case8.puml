@startuml
' Configurações visuais
skinparam maxMessageSize 150
skinparam handwritten false
skinparam responseMessageBelowArrow true
autonumber

actor "Técnico / Admin" as user
participant "Interface (PWA)" as pwa
participant "Agendador\n(@Scheduled)" as cron

box "Módulo: Governance" #F5F5F5
    participant "SlaMonitorService" as slaService
    database "Banco de Dados" as db
end box

box "Event Bus Interno" #FFFFE0
    participant "Spring Event\nPublisher" as eventBus
end box

box "Módulos Secundários" #E8F8F5
    participant "AuditLogService" as audit
    participant "NotificacaoService" as notif
end box

== Verificação Contínua de SLA ==
note over cron, slaService: Rotina automática executada em background\n(ex: a cada 5 minutos pelo servidor).

cron -> slaService : verificarSlaChamados()
activate slaService

slaService -> db : SELECT * FROM chamados\nWHERE status NOT IN ('RESOLVIDO', 'FECHADO')
activate db
db --> slaService : Retorna chamados com cronômetro ativo
deactivate db

loop Para cada chamado ativo
    slaService -> slaService : Calcula tempo restante cruzando:\nData Abertura vs Prioridade

    alt SLA Próximo do Vencimento (Alerta Preventivo)
        slaService -> slaService : Verifica se alerta já foi enviado
        slaService -> db : UPDATE chamados SET alerta_sla_enviado = true
        slaService -> eventBus : publishEvent(SlaProximoVencimentoEvent)
        
    else SLA Vencido (Violação do Prazo)
        slaService -> slaService : Verifica se violação já foi registrada
        slaService -> db : UPDATE chamados SET sla_violado = true
        slaService -> eventBus : publishEvent(SlaVioladoEvent)
    end
end
deactivate slaService

== Processamento de Alertas e Auditoria (@Async) ==

' Módulo de Auditoria escuta o rompimento
eventBus ->> audit : Recebe SlaVioladoEvent
activate audit
audit -> db : INSERT INTO log_auditoria\n(Ação: Violação de SLA de Resolução)
deactivate audit

' Módulo de Notificações escuta os eventos
eventBus ->> notif : Recebe Eventos de SLA (Preventivo / Violado)
activate notif
notif -> notif : Formata mensagens (Templates)
notif ->> user : Dispara Notificações (E-mail / PWA)
deactivate notif

== Reflexo Visual na Interface ==

user -> pwa : Acessa fila de chamados (Backlog/Kanban)
pwa ->[...] : GET /chamados (Via TicketController)
[...] --> pwa : Retorna dados (com flag sla_violado = true)
pwa --> user : Renderiza cards com marcadores visuais\n(ex: Badge vermelho ou borda destacada)

@enduml