@startuml
' Configurações Visuais Profissionais e Organização
skinparam class {
  BackgroundColor White
  ArrowColor #333333
  BorderColor #333333
}
skinparam handwritten false
skinparam classAttributeIconSize 0

' Mantendo as linhas retas e espaçamento
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70

' ================= ARQUITETURA: PACOTE POR COMPONENTE =================

package "Módulo: Identidade e Acesso (auth)" <<Folder>> {
  enum PerfilAcesso {
    ADMINISTRADOR
    TECNICO
    USUARIO_COMUM
  }

  class Departamento {
    - id: Long
    - nome: String
    - sigla: String
  }

  class Usuario {
    - id: Long
    - nome: String
    - email: String
    - hashSenha: String
    - perfil: PerfilAcesso
    - status: StatusUsuario
    - matriculaTecnica: String <<Nullable>>
    + autenticar(senhaString): boolean
    + alterarPerfil(novoPerfil): void
  }
}

package "Módulo: Gestão de Chamados (tickets)" <<Folder>> {
  enum StatusChamado {
    ABERTO
    EM_ANDAMENTO
    AGUARDANDO_USUARIO
    RESOLVIDO
    FECHADO
  }
  
  enum NivelPrioridade {
    BAIXA
    MEDIA
    ALTA
    CRITICA
  }
  
  enum TipoVisibilidade {
    PUBLICO
    INTERNO_TI
  }

  class Categoria {
    - id: Long
    - nome: String
    - descricao: String
    - ativo: boolean
  }

  class Chamado {
    - id: Long
    - solicitanteId: Long
    - tecnicoAtribuidoId: Long <<Nullable>>
    - departamentoOrigemId: Long
    - titulo: String
    - descricao: String
    - dataAbertura: LocalDateTime
    - dataFechamento: LocalDateTime
    - status: StatusChamado
    - prioridade: NivelPrioridade
    - tempoSlaHoras: Integer
    - slaViolado: boolean
    - solucaoAplicada: String
    + atualizarStatus(novoStatus): void
    + calcularSlaRestante(): Integer
  }

  class Comentario {
    - id: Long
    - autorId: Long
    - texto: String
    - dataHora: LocalDateTime
    - visibilidade: TipoVisibilidade
  }

  class Anexo {
    - id: Long
    - nomeArquivo: String
    - caminhoUrl: String
    - tamanhoKb: Integer
    - dataUpload: LocalDateTime
  }
}

package "Módulo: Governança e Auditoria (governance)" <<Folder>> {
  class LogAuditoria {
    - id: Long
    - entidadeAlvoId: Long
    - nomeEntidade: String
    - payloadAlteracoes: String <<JSONB>>
    - usuarioAutorId: Long
    - dataHora: LocalDateTime
  }
}

' ================= Relacionamentos Internos dos Módulos =================

' Auth (Hard References)
Usuario "*" -up-> "1" Departamento : pertence a

' Tickets (Hard References)
Chamado "*" -left-> "1" Categoria : classificado em
Categoria "0..1" -up-> "*" Categoria : subcategoria de
Chamado "1" *-right- "*" Comentario : contém
Chamado "1" *-down- "*" Anexo : possui

' ================= Relacionamentos Cruzados (Soft References) =================

note "Diretriz de Monólito Modular:\nRelacionamentos entre módulos usam referências por ID\ne setas de dependência fraca para garantir o baixo acoplamento." as N1

' Tickets -> Auth (Dependência Fraca)
Chamado ..> Usuario : solicitanteId /\ntecnicoAtribuidoId >
Chamado ..> Departamento : departamentoOrigemId >
Comentario ..> Usuario : autorId >

' Governance -> Qualquer Módulo (Dependência Fraca)
LogAuditoria ..> Usuario : usuarioAutorId >

@enduml